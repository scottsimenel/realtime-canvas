# Ignore node modules and dependencies in monorepo
node_modules/
dist/
build/
.cache/
.DS_Store

# Local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Server uploads
server/public/uploads/

# Server save snapshots (runtime autosave state, not source)
server/saves/


# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# Windows reserved name
/nul
nul

